# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 저장소에 올리지 않는다.

# Supabase > Project Settings > Database > Connection string > Session pooler 의 주소.
# 직접 연결(Direct connection) 주소는 IPv6 전용이라 일부 네트워크에서 붙지 않는다.
DATABASE_URL=postgresql://postgres.<프로젝트 ref>:<DB 비밀번호>@<pooler 주소>:5432/postgres

# Jira 연동 (M5). 토큰은 서버에만 두고 프론트엔드·저장소에 넣지 않는다. 필드·선택값 ID는 docs/06 6장 참고.
JIRA_BASE_URL=https://<사이트>.atlassian.net
JIRA_EMAIL=<서비스 계정 이메일>
JIRA_API_TOKEN=<API 토큰>
JIRA_PROJECT_KEY=ITS
