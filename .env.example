# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 저장소에 올리지 않는다.

# 로컬 개발: Supabase > Project Settings > Database > Connection string > Session pooler 의 주소.
# 직접 연결(Direct connection) 주소는 IPv6 전용이라 일부 네트워크에서 붙지 않는다.
DATABASE_URL=postgresql://postgres.<프로젝트 ref>:<DB 비밀번호>@<pooler 주소>:5432/postgres
# 운영 서버: 위 줄 대신 아래를 쓴다. POSTGRES_ 값은 DB 를 처음 올릴 때 한 번만 적용된다.
# 주소에 그대로 들어가므로 특수문자 없는 값을 권장한다 (비밀번호 예: openssl rand -hex 32)
# POSTGRES_DB=<DB 이름>
# POSTGRES_USER=<DB 사용자>
# POSTGRES_PASSWORD=<무작위 값>
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# DB 연결 풀. 개발 PC 는 아래 값을 쓰고, 서버는 두 줄을 지워 기본값으로 둔다
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=3

# Jira 연동 (ITHD). 토큰은 https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급.
JIRA_BASE_URL=https://itssuehelpdesk.atlassian.net
JIRA_EMAIL=<API 토큰을 발급한 Atlassian 계정 이메일>
JIRA_API_TOKEN=<Atlassian API 토큰>
# Jira 웹훅 설정의 비밀값과 같은 값. 없으면 웹훅(TK-13)을 모두 401 로 거절한다
JIRA_WEBHOOK_SECRET=<무작위 값>

# 로그인 토큰. JWT_SECRET 은 32자 이상 무작위 값 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=<32자 이상 무작위 값>
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# 로컬 http 개발에서 Refresh 쿠키가 안 오가면 false. 배포(https)는 true
REFRESH_COOKIE_SECURE=true

# 임베딩 모델 (검색). 모델 폴더 기본은 저장소 바로 옆 models/. 서버(EC2)는 /home/ubuntu/models
# EMBEDDING_MODEL_DIR=/home/ubuntu/models
# 서버는 true: 시작할 때 모델을 미리 연다 (EC2 약 28초). 개발 PC는 비워 두면 첫 검색 때 연다
# EMBEDDING_PRELOAD=true

# Claude API (AI 판단). 키는 https://console.anthropic.com 에서 발급.
LLM_API_KEY=<Claude API 키>
LLM_MODEL=claude-sonnet-5-5

# AI 상담 대화 설정 (docs/09 4.2, docs/08 5.6). 시작값이며 테스트 후 조정한다
# 답을 못 얻은 추가 질문이 이 횟수가 되면 담당자 연결 제안
ASK_MORE_UNANSWERED_LIMIT=2
# 추가 질문이 이 횟수가 되면 담당자 연결 제안
ASK_MORE_TOTAL_LIMIT=5
# AI 에 함께 보낼 이전 대화 메시지 수 (사용자·AI 메시지를 각각 하나로 셈)
AI_HISTORY_LIMIT=10
