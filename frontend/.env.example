# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 저장소에 올리지 않는다.
# 비밀 값(API 키, DB 비밀번호 등)은 프런트엔드에 넣지 않는다. VITE_ 로 시작하는 값은 브라우저에 그대로 노출된다.

# API 서버 주소. 비워 두면 같은 출처의 /api 로 호출하고, 개발 서버(Vite)가 FastAPI 로 넘겨 준다.
VITE_API_BASE_URL=/api

# false 로 바꾸면 가짜 응답(mock) 대신 실제 API 를 호출한다. 백엔드 연동 전에는 true (기본값).
VITE_USE_MOCK=true

# 개발 서버가 /api 요청을 넘길 FastAPI 주소
VITE_DEV_PROXY_TARGET=http://localhost:8000
